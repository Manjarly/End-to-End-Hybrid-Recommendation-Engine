{
    "git.ignoreLimitWarning": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/data/**": true,
        "**/.pytest_cache/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}